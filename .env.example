POSTGRES_PASSWORD=change-me
# Encrypts the stored ChatGPT sign-in. Generate once: openssl rand -hex 32
BHASHA_SECRET_KEY=
# Shared by bhasha and its speech service(s). Generate once: openssl rand -hex 24
BHASHA_SPEECH_TOKEN=
# Speech hosts in order; prepend a GPU PC, e.g. http://gaming-pc:8790,http://speech:8790
# BHASHA_SPEECH_URLS=http://speech:8790
BHASHA_TIMEZONE=America/New_York
BHASHA_PORT=8000
# Traefik (optional)
TRAEFIK_ENABLE=false
BHASHA_HOST=bhasha.example.lan
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_NETWORK=proxy
